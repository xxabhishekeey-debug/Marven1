# Copy to .env for Docker Compose. Development values only; rotate all secrets in production.
POSTGRES_DB=sih26094
DB_URL=jdbc:postgresql://postgres:5432/sih26094
DB_USERNAME=sih26094
DB_PASSWORD=sih26094_dev
DB_POOL_SIZE=10
SERVER_PORT=8080
JWT_SECRET=replace-with-at-least-32-random-bytes-before-production
JWT_EXPIRATION=8h
FRONTEND_URL=http://localhost:5173

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false
REDIS_TIMEOUT=2s

AI_SERVICE_URL=http://host.docker.internal:8000
AI_CONNECT_TIMEOUT=2s
AI_READ_TIMEOUT=10s
AI_MOCK_ENABLED=true

SCORING_QUEUE=sih26094:scoring:ready
SCORING_RETRY_QUEUE=sih26094:scoring:retry
SCORING_DEAD_LETTER=sih26094:scoring:dead
SCORING_MAX_ATTEMPTS=5
SCORING_BACKOFF=5s
SCORING_STATUS_TTL=7d
SCORING_POLL_DELAY=1s
SCORING_RECOVERY_DELAY=1m
ALERT_HIGH_DDS=70
ALERT_CRITICAL_DDS=85

SCHEDULING_ENABLED=true
SCHEDULE_LOW_INTERVAL=7d
SCHEDULE_MODERATE_INTERVAL=3d
SCHEDULE_HIGH_INTERVAL=1d
SCHEDULE_SCAN_DELAY=1h
# The bundled provider supports "mock" (server log plus authorized WebSocket delivery).
NOTIFICATIONS_MODE=mock
